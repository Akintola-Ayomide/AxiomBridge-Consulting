# Optional. On Vercel, the automatic vercel.app URL is used when this is blank.
# Set this only when using a custom domain or a non-Vercel host.
NEXT_PUBLIC_SITE_URL=

# Public contact details rendered in the header, footer and contact page.
NEXT_PUBLIC_CONTACT_EMAIL=contact@axiombridge.com
NEXT_PUBLIC_CONTACT_PHONE=+234 1 800 2946

# Optional public social profile. Leave blank to omit the link.
NEXT_PUBLIC_LINKEDIN_URL=

# FormSubmit recipient. Use the email address or the alias FormSubmit issues
# after activation. This is public by design because the browser posts to it.
NEXT_PUBLIC_FORMSUBMIT_RECIPIENT=

# Optional email subject used for enquiry notifications.
NEXT_PUBLIC_FORMSUBMIT_SUBJECT=New website enquiry — AxiomBridge Consulting

# FormSubmit enables reCAPTCHA by default. Set to false only if you need to
# disable it. The honeypot field is always included.
NEXT_PUBLIC_FORMSUBMIT_CAPTCHA=true

# Optional comma-separated spam phrases ignored by FormSubmit.
NEXT_PUBLIC_FORMSUBMIT_BLACKLIST=
