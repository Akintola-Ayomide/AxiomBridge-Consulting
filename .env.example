# Public site URL used for canonical URLs, metadata, sitemap and robots.
# Required in production. Falls back to http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public contact details rendered in the header, footer and contact page.
NEXT_PUBLIC_CONTACT_EMAIL=contact@axiombridge.com
NEXT_PUBLIC_CONTACT_PHONE=+234 1 800 2946

# Optional public social profile. Leave blank to omit the link.
NEXT_PUBLIC_LINKEDIN_URL=

# Resend credentials. These are server-only and must never use a NEXT_PUBLIC_ prefix.
# The enquiry endpoint returns 503 until all three values are supplied.
RESEND_API_KEY=
# Must be a sender address verified in your Resend account.
ENQUIRY_FROM_EMAIL=
# Inbox that receives enquiry notifications.
ENQUIRY_TO_EMAIL=
